# ============================================================
# College Football Predictor — environment configuration
# Copy to .env and fill in. NEVER commit the real .env.
# ============================================================

# --- Core data (required, free) ---
# Register at https://collegefootballdata.com/key
CFBD_API_KEY=

# --- Odds / lines (required) ---
# https://the-odds-api.com (free tier: 500 req/mo; props + historical need paid)
# Historical pulls cost 10 credits x market x region x event — see the usage log
# at warehouse/raw/odds/odds_usage.jsonl before running a big backfill.
ODDS_API_KEY=

# Optional alternatives (leave blank if unused)
ODDSJAM_API_KEY=
UNABATED_API_KEY=

# --- LLM / embeddings (you have these) ---
# OpenAI — used for text embeddings of news/injury/depth-chart text
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Anthropic Claude — structured extraction from news + weekly analyst memos
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-sonnet-5
CLAUDE_MODEL_DEEP=claude-fable-5

# --- Weather (free, no key needed for Open-Meteo; NWS optional) ---
WEATHER_PROVIDER=open-meteo

# --- Storage ---
# Start with SQLite; switch to Postgres when data grows
DATABASE_URL=sqlite:///./warehouse/cfb.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/cfb
PARQUET_DIR=./warehouse/parquet
RAW_DIR=./warehouse/raw
EMBEDDINGS_DIR=./warehouse/embeddings

# --- Modeling / backtest ---
RANDOM_SEED=42
TRAIN_SEASONS=2016-2024
HOLDOUT_SEASON=2025
# Betting sim settings
KELLY_FRACTION=0.25
MIN_EDGE_SPREAD_PTS=2.0
MIN_EDGE_PROP_EV=0.03
BANKROLL_UNITS=100

# --- Ops ---
LOG_LEVEL=INFO
TIMEZONE=America/Chicago
